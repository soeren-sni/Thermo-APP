# Nur auf dem eigenen Backend-Host konfigurieren. Keine echten Werte in Git!
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
# UID des mit Projekt Heim verknüpften Smart-Life/Tuya-App-Kontos (nicht Cloud-Token-UID)
TUYA_ACCOUNT_UID=
# Eigenes zufälliges Lesetoken, getrennt vom Tuya Secret, mindestens 32 Zeichen
THERMO_BRIDGE_TOKEN=
THERMO_BRIDGE_PORT=8787
# Optionaler lokaler Betrieb, unabhängig von Tuya IoT Core:
# THERMO_PROVIDER=homeassistant
# HA_URL=http://127.0.0.1:8123
# HA_READ_TOKEN=
# HA_MAPPING_FILE=/absoluter/pfad/private/ha_entities.json
