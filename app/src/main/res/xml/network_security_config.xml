<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors><certificates src="system" /></trust-anchors>
    </base-config>
    <!-- Emulator/Debug: a deliberately installed private LAN CA may be trusted.
         Release builds trust system CAs only. Never disable certificate/hostname checks. -->
    <debug-overrides>
        <trust-anchors><certificates src="user" /></trust-anchors>
    </debug-overrides>
</network-security-config>
